# VK Teams Bot API
VK_TEAMS_BOT_TOKEN=
VK_TEAMS_API_URL=

# Источник презентаций: по умолчанию папка presentations/ рядом с приложением (не в git, заливается при деплое).
# Раскомментировать и указать свой путь, только если нужна папка в другом месте.
# PRESENTATIONS_FOLDER_PATH=/absolute/path/to/presentations

# «Парадные» копии презентаций без заметок/комментариев (PublicCopyBuilder) — их отдаёт :8080 для ссылок из чата.
# PRESENTATIONS_PUBLIC_FOLDER_PATH=/absolute/path/to/presentations-public

# Синхронизация с Google Drive (сервисный аккаунт, ключ в config/google/ — не в git).
# GOOGLE_SERVICE_ACCOUNT_JSON=config/google/service-account.json
# GOOGLE_PRESENTATION_ID=1tZ_CMsn_hxzeL-ActyXWuFlTA_ZjONZ2Cewmz8UgbaA

# Интервал недельного цикла синхронизации (bin/sync.php), сек. По умолчанию 604800 = 7 дней.
# SYNC_INTERVAL_SECONDS=604800

# Catalog storage (JSON или SQLite, см. §5.1.9 ТЗ)
CATALOG_STORAGE_PATH=storage/catalog/catalog.sqlite

# Python-подпроцессы (SlideTextExtractor, SlideCloner)
PYTHON_BIN=python

# Лимиты сборки: максимум слайдов-кейсов в подборке и минимум (см. ниже), до которого
# подборка добирается «похожими» кейсами — сначала по связанным тегам (config/tag-relations.php),
# затем по смыслу через LLM.
MAX_SLIDES_PER_DECK=10
# MIN_SLIDES_PER_DECK=5

# LLM для дополнения тегов кейсов (см. src/Api/Providers). provider: ollama | opencodezen
AI_PROVIDER=opencodezen
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=
OPENCODEZEN_API_KEY=
OPENCODEZEN_MODEL=
# Базовый URL API: pay-as-you-go по умолчанию; для подписки OpenCode Go раскомментировать:
# OPENCODEZEN_BASE_URL=https://opencode.ai/zen/go/v1
# Стабильный id сессии для Go-эндпоинта (любая непустая строка, одна на установку).
# OPENCODEZEN_SESSION_ID=casesbot

# Веб-загрузчик презентаций (public/upload.php, :8081) — HTTP Basic Auth.
# Без обоих значений страница отказывает в доступе (fail closed).
UPLOAD_USERNAME=
UPLOAD_PASSWORD=
